{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./package-lock.json)",
      "Read(./**/*.tsbuildinfo)",
      "Read(./lib/illustrations/**/*.svg)",
      "Read(./lib/fonts/**/*.woff2)",
      "Read(./lib/fonts/**/*.ttf)",
      "Read(./**/*.glb)",
      "Read(./**/*.hdr)",
      "Read(./**/*.ktx2)",
      "Read(./**/*.basis)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agents-autostart.py\"",
            "timeout": 10,
            "statusMessage": "3D specialists router: analyzing request…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.sh\"",
            "timeout": 30,
            "statusMessage": "eslint sul file toccato…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pipeline-next.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
